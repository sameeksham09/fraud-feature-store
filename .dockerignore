# ============================================================
# .dockerignore - Files to EXCLUDE from Docker images
# This prevents secrets and large files from being included
# ============================================================

# --- Version Control ---
.git
.gitignore

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
.venv/
pip-log.txt
pip-delete-this-directory.txt

# --- IDEs ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- Project Specific (Secrets!) ---
.env
*.env
mlruns/
*.log
dump.rdb

# --- Testing ---
.pytest_cache/
.coverage
htmlcov/
.tox/

# --- OS ---
.DS_Store
Thumbs.db

# --- Documentation ---
README.md
CLAUDE.md
*.md

# --- Docker ---
docker-compose.yml
docker-compose.override.yml
Dockerfile
